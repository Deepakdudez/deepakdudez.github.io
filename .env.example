# ==========================================
# Deepak Kumar Portfolio - Environment Config
# ==========================================

# Port & Server Configuration
VITE_PORT=3000
VITE_APP_URL=http://localhost:3000

# AI Provider Configuration (Optional for remote LLM fallback)
# Defaults to local client-side / edge RAG vector retriever
VITE_AI_PROVIDER=local_rag
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# Contact Webhook / Formspree (Optional)
VITE_CONTACT_WEBHOOK_URL=

# Analytics (Privacy-conscious, cookie-less)
VITE_ANALYTICS_ENABLED=false
